<Window x:Class="Crypture.SqlServerVaultDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SQL Server Vault" Width="520" Height="430" MinWidth="480" MinHeight="400"
    WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
    Background="{DynamicResource Crypture.WindowBrush}"
    Foreground="{DynamicResource Crypture.TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="145" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,16" TextWrapping="Wrap"
            Text="Connect to an existing Crypture Vault, or create a new database on SQL Server." />
        <Label Grid.Row="1" Grid.Column="0" Content="_Server:" Target="{Binding ElementName=oServer}" />
        <TextBox x:Name="oServer" Grid.Row="1" Grid.Column="1" MinHeight="28" Margin="0,0,0,8"
            AutomationProperties.Name="SQL Server name" />
        <Label Grid.Row="2" Grid.Column="0" Content="_Database:" Target="{Binding ElementName=oDatabase}" />
        <TextBox x:Name="oDatabase" Grid.Row="2" Grid.Column="1" MinHeight="28" Margin="0,0,0,8"
            AutomationProperties.Name="SQL Server database name" />
        <Label Grid.Row="3" Grid.Column="0" Content="_Authentication:" Target="{Binding ElementName=oAuthentication}" />
        <ComboBox x:Name="oAuthentication" Grid.Row="3" Grid.Column="1" MinHeight="28" Margin="0,0,0,8"
            SelectionChanged="oAuthentication_SelectionChanged">
            <ComboBoxItem Content="Windows" />
            <ComboBoxItem Content="SQL Server login" />
        </ComboBox>
        <Label Grid.Row="4" Grid.Column="0" Content="_User name:" Target="{Binding ElementName=oUserName}" />
        <TextBox x:Name="oUserName" Grid.Row="4" Grid.Column="1" MinHeight="28" Margin="0,0,0,8"
            AutomationProperties.Name="SQL Server user name" />
        <Label Grid.Row="5" Grid.Column="0" Content="_Password:" Target="{Binding ElementName=oPassword}" />
        <PasswordBox x:Name="oPassword" Grid.Row="5" Grid.Column="1" MinHeight="28" Margin="0,0,0,8"
            AutomationProperties.Name="SQL Server password" />
        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,6,0,0">
            <CheckBox x:Name="oTrustCertificate" Content="Trust the server certificate"
                ToolTip="Use only when you have verified the SQL Server by another means." />
            <CheckBox x:Name="oCreateDatabase" Margin="0,10,0,0" Content="Create a new database"
                ToolTip="Requires CREATE DATABASE permission. Existing databases are never overwritten." />
        </StackPanel>
        <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Margin="0,12,0,0" TextWrapping="Wrap"
            Foreground="{DynamicResource Crypture.MutedBrush}">
            <Run Text="Connections are encrypted. Vault contents stay encrypted; labels and recipients " />
            <Run Text="are visible to database administrators. SQL login passwords stay in memory." />
        </TextBlock>
        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="100" MinHeight="30" Margin="0,0,8,0" Content="Connect" IsDefault="True"
                Click="oConnect_Click" />
            <Button Width="100" MinHeight="30" Content="Cancel" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
