<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Crypture" xmlns:properties="clr-namespace:Crypture.Properties"
    xmlns:ribbon="clr-namespace:System.Windows.Controls.Ribbon;assembly=System.Windows.Controls.Ribbon">

    <SolidColorBrush x:Key="Crypture.WindowBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Crypture.PanelBrush" Color="#F6F8FB" />
    <SolidColorBrush x:Key="Crypture.ControlBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Crypture.TextBrush" Color="#17212F" />
    <SolidColorBrush x:Key="Crypture.MutedBrush" Color="#475569" />
    <SolidColorBrush x:Key="Crypture.BorderBrush" Color="#D6DEE8" />
    <SolidColorBrush x:Key="Crypture.HoverBrush" Color="#E8F2FE" />
    <SolidColorBrush x:Key="Crypture.SelectionBrush" Color="#D7EAFE" />
    <SolidColorBrush x:Key="Crypture.AccentBrush" Color="#0F6CBD" />
    <SolidColorBrush x:Key="Crypture.DisabledBrush" Color="#687582" />
    <SolidColorBrush x:Key="Crypture.WarningBrush" Color="#9A3412" />

    <local:SecretFontConverter x:Key="Crypture.SecretFontConverter" />

    <Style x:Key="Crypture.ControlStyle" TargetType="Control">
        <Setter Property="Background" Value="{DynamicResource Crypture.ControlBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource Crypture.TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Crypture.BorderBrush}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Crypture.DisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="Label" BasedOn="{StaticResource Crypture.ControlStyle}">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource Crypture.ControlStyle}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource Crypture.TextBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Crypture.AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Border" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush"
                                Value="{DynamicResource Crypture.AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource Crypture.PanelBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Crypture.SecretText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontFamily">
            <Setter.Value>
                <Binding Source="{x:Static properties:Settings.Default}" Path="SecretFontFamily" Mode="OneWay"
                    Converter="{StaticResource Crypture.SecretFontConverter}" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource Crypture.ControlStyle}">
        <Setter Property="Background" Value="{DynamicResource Crypture.PanelBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="2"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background"
                                Value="{DynamicResource Crypture.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background"
                                Value="{DynamicResource Crypture.SelectionBrush}" />
                        </Trigger>
                        <Trigger Property="IsDefaulted" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush"
                                Value="{DynamicResource Crypture.AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush"
                                Value="{DynamicResource Crypture.AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Background"
                                Value="{DynamicResource Crypture.PanelBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource Crypture.ControlStyle}">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel Background="Transparent">
                        <Border x:Name="Indicator" Width="14" Height="14" BorderThickness="1" CornerRadius="1"
                            VerticalAlignment="Center" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}">
                            <Grid>
                                <Path x:Name="Check" Data="M 2,6 L 5,9 L 10,3" StrokeThickness="2"
                                    Stroke="{TemplateBinding Foreground}" Visibility="Collapsed" />
                                <Rectangle x:Name="Indeterminate" Margin="3" Fill="{TemplateBinding Foreground}"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ContentPresenter Margin="5,0,0,0" RecognizesAccessKey="True"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Indeterminate" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Indicator" Property="Background"
                                Value="{DynamicResource Crypture.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Indicator" Property="BorderBrush"
                                Value="{DynamicResource Crypture.AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="RadioButton" BasedOn="{StaticResource Crypture.ControlStyle}">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <DockPanel Background="Transparent">
                        <Border x:Name="Indicator" Width="14" Height="14" BorderThickness="1" CornerRadius="7"
                            VerticalAlignment="Center" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}">
                            <Ellipse x:Name="Check" Margin="3" Fill="{TemplateBinding Foreground}"
                                Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="5,0,0,0" RecognizesAccessKey="True"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Indicator" Property="Background"
                                Value="{DynamicResource Crypture.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Indicator" Property="BorderBrush"
                                Value="{DynamicResource Crypture.AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource Crypture.ControlStyle}">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Crypture.SelectionBrush}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Crypture.HoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource Crypture.ControlStyle}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Border" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" />
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background"
                                                Value="{DynamicResource Crypture.HoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="6,3,24,3" VerticalAlignment="Center" IsHitTestVisible="False"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <Path Data="M 0,0 L 4,4 L 8,0" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8" IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                            AllowsTransparency="True" Focusable="False">
                            <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                Background="{DynamicResource Crypture.ControlBrush}"
                                BorderBrush="{DynamicResource Crypture.BorderBrush}" BorderThickness="1">
                                <ScrollViewer CanContentScroll="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Crypture.AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource Crypture.PanelBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="local:SecretFontSelector" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="MaxDropDownHeight" Value="250" />
        <Setter Property="AutomationProperties.Name" Value="Secret Font" />
        <Setter Property="ToolTip"
            Value="Choose the font for secret text and generated passwords. Remembered for your Windows profile." />
    </Style>
    <Style TargetType="ListBox" BasedOn="{StaticResource Crypture.ControlStyle}" />
    <Style TargetType="ListView" BasedOn="{StaticResource Crypture.ControlStyle}" />
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Crypture.ControlStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Crypture.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Crypture.SelectionBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListBoxItem}}" />
    <Style TargetType="DataGrid" BasedOn="{StaticResource Crypture.ControlStyle}">
        <Setter Property="Background" Value="{DynamicResource Crypture.WindowBrush}" />
        <Setter Property="RowBackground" Value="{DynamicResource Crypture.WindowBrush}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Crypture.PanelBrush}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Crypture.BorderBrush}" />
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{DynamicResource Crypture.TextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Crypture.SelectionBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource Crypture.TextBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{DynamicResource Crypture.AccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Crypture.HeaderGripper" TargetType="Thumb">
        <Setter Property="Width" Value="8" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Crypture.ControlStyle}">
        <Setter Property="Background" Value="{DynamicResource Crypture.PanelBrush}" />
        <Setter Property="Padding" Value="5,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Crypture.BorderBrush}" BorderThickness="0,0,1,1"
                            Padding="{TemplateBinding Padding}">
                            <DockPanel>
                                <Path x:Name="SortArrow" DockPanel.Dock="Right" Fill="{TemplateBinding Foreground}"
                                    Data="M 0,4 L 4,0 L 8,4 Z" VerticalAlignment="Center" Margin="6,0,0,0"
                                    Visibility="Collapsed" />
                                <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left"
                            Style="{StaticResource Crypture.HeaderGripper}" />
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                            Style="{StaticResource Crypture.HeaderGripper}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Crypture.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SortArrow" Property="Data" Value="M 0,0 L 4,4 L 8,0 Z" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="GroupBox" BasedOn="{StaticResource Crypture.ControlStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.RowSpan="2" Margin="0,8,0,0" CornerRadius="3" BorderThickness="1"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" />
                        <Border Margin="8,0,0,0" Padding="3,0" HorizontalAlignment="Left"
                            Background="{DynamicResource Crypture.WindowBrush}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </Border>
                        <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TabControl" BasedOn="{StaticResource Crypture.ControlStyle}">
        <Setter Property="Background" Value="{DynamicResource Crypture.WindowBrush}" />
    </Style>
    <Style TargetType="TabItem" BasedOn="{StaticResource Crypture.ControlStyle}">
        <Setter Property="Background" Value="{DynamicResource Crypture.PanelBrush}" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                        BorderThickness="1" BorderBrush="{DynamicResource Crypture.BorderBrush}">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Crypture.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Crypture.SelectionBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="StatusBar" BasedOn="{StaticResource Crypture.ControlStyle}">
        <Setter Property="Background" Value="{DynamicResource Crypture.PanelBrush}" />
    </Style>
    <Style TargetType="ToolTip" BasedOn="{StaticResource Crypture.ControlStyle}">
        <Setter Property="Background" Value="{DynamicResource Crypture.PanelBrush}" />
    </Style>
    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource Crypture.BorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DatePickerTextBox" BasedOn="{StaticResource {x:Type TextBox}}" />
    <Style TargetType="CalendarDayButton" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsInactive" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Crypture.MutedBrush}" />
            </Trigger>
            <Trigger Property="IsBlackedOut" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Crypture.DisabledBrush}" />
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
            <Trigger Property="IsToday" Value="True">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{DynamicResource Crypture.AccentBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Crypture.SelectionBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="CalendarButton" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="MinHeight" Value="44" />
        <Style.Triggers>
            <Trigger Property="HasSelectedDays" Value="True">
                <Setter Property="Background" Value="{DynamicResource Crypture.SelectionBrush}" />
            </Trigger>
            <Trigger Property="IsInactive" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Crypture.MutedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="CalendarItem" BasedOn="{StaticResource Crypture.ControlStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarItem">
                    <ControlTemplate.Resources>
                        <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                            <TextBlock Text="{Binding}" HorizontalAlignment="Center" Margin="2,6"
                                Foreground="{DynamicResource Crypture.MutedBrush}" />
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Border Background="{DynamicResource Crypture.PanelBrush}" Padding="6"
                        BorderBrush="{DynamicResource Crypture.BorderBrush}" BorderThickness="1">
                        <Grid x:Name="PART_Root">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PART_PreviousButton" Content="&#x2039;" MinWidth="28"
                                Focusable="False" AutomationProperties.Name="Previous" />
                            <Button x:Name="PART_HeaderButton" Grid.Column="1" Focusable="False" />
                            <Button x:Name="PART_NextButton" Grid.Column="2" Content="&#x203A;" MinWidth="28"
                                Focusable="False" AutomationProperties.Name="Next" />
                            <Grid x:Name="PART_MonthView" Grid.Row="1" Grid.ColumnSpan="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                            <Grid x:Name="PART_YearView" Grid.Row="1" Grid.ColumnSpan="3" Visibility="Hidden">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}"
                            Value="Year">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType=Calendar}}"
                            Value="Decade">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Calendar" BasedOn="{StaticResource Crypture.ControlStyle}">
        <Setter Property="CalendarItemStyle" Value="{StaticResource {x:Type CalendarItem}}" />
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource {x:Type CalendarDayButton}}" />
        <Setter Property="CalendarButtonStyle" Value="{StaticResource {x:Type CalendarButton}}" />
    </Style>
    <Style TargetType="DatePicker" BasedOn="{StaticResource Crypture.ControlStyle}">
        <Setter Property="CalendarStyle" Value="{StaticResource {x:Type Calendar}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid x:Name="PART_Root">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <DatePickerTextBox x:Name="PART_TextBox" Padding="3" MinWidth="80" />
                        <Button x:Name="PART_Button" Grid.Column="1" Focusable="False" Padding="5,2"
                            AutomationProperties.Name="Choose Date">
                            <Path Width="12" Height="12" Stroke="{DynamicResource Crypture.TextBrush}"
                                Data="M 0,2 L 12,2 L 12,12 L 0,12 Z M 0,5 L 12,5 M 3,0 L 3,4 M 9,0 L 9,4" />
                        </Button>
                        <Popup x:Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource Crypture.ControlStyle}">
        <Setter Property="Background" Value="{DynamicResource Crypture.PanelBrush}" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="Decrease" Command="ScrollBar.PageUpCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Grip" Margin="3" CornerRadius="3"
                                                Background="{DynamicResource Crypture.BorderBrush}" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Grip" Property="Background"
                                                        Value="{DynamicResource Crypture.MutedBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="Increase" Command="ScrollBar.PageDownCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto" />
                            <Setter Property="Height" Value="14" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            <Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand" />
                            <Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Use original Windows 10 glyphs for Windows Server 2016 and later. -->
    <Style x:Key="Crypture.Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontStyle" Value="Normal" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Margin" Value="0,0,7,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Crypture.AccentBrush}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Crypture.DisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <DataTemplate x:Key="Crypture.GlyphContent">
        <DockPanel LastChildFill="True">
            <TextBlock Style="{StaticResource Crypture.Glyph}"
                Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
            <AccessText Text="{Binding}" VerticalAlignment="Center" />
        </DockPanel>
    </DataTemplate>
    <Style x:Key="Crypture.GlyphLabel" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
        <Setter Property="ContentTemplate" Value="{StaticResource Crypture.GlyphContent}" />
    </Style>
    <Style x:Key="Crypture.GlyphButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="ContentTemplate" Value="{StaticResource Crypture.GlyphContent}" />
    </Style>
    <Style x:Key="Crypture.CopyButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Content" Value="&#xE8C8;" />
        <Setter Property="AutomationProperties.Name" Value="Copy to Clipboard" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="ToolTip" Value="Copy to the clipboard. Clears after 5 minutes or when Crypture closes." />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource Crypture.Glyph}" Margin="0" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Crypture.CopyValueButton" TargetType="Button" BasedOn="{StaticResource Crypture.CopyButton}">
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Null}">
                <Setter Property="IsEnabled" Value="False" />
            </Trigger>
            <Trigger Property="Tag" Value="">
                <Setter Property="IsEnabled" Value="False" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Crypture.GlyphTab" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
        <Setter Property="HeaderTemplate" Value="{StaticResource Crypture.GlyphContent}" />
    </Style>
    <Style x:Key="Crypture.GlyphGroup" TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
        <Setter Property="HeaderTemplate" Value="{StaticResource Crypture.GlyphContent}" />
    </Style>
    <Style x:Key="Crypture.GlyphColumn" TargetType="DataGridColumnHeader"
        BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="ContentTemplate" Value="{StaticResource Crypture.GlyphContent}" />
    </Style>

    <ribbon:RibbonControlSizeDefinition x:Key="Crypture.LargeRibbonControl"
        ImageSize="Large" IsLabelVisible="True" />
    <ribbon:RibbonControlSizeDefinition x:Key="Crypture.SmallRibbonControl"
        ImageSize="Small" IsLabelVisible="True" />
    <Style TargetType="ribbon:RibbonTabHeaderItemsControl">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ribbon:RibbonTabHeaderItemsControl">
                    <ItemsPresenter x:Name="ItemsPresenter" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ribbon:Ribbon" BasedOn="{StaticResource Crypture.ControlStyle}">
        <Setter Property="TabHeaderStyle" Value="{DynamicResource {x:Type ribbon:RibbonTabHeader}}" />
        <Setter Property="Background" Value="{DynamicResource Crypture.PanelBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="MouseOverBackground" Value="{DynamicResource Crypture.HoverBrush}" />
        <Setter Property="MouseOverBorderBrush" Value="{DynamicResource Crypture.BorderBrush}" />
        <Setter Property="PressedBackground" Value="{DynamicResource Crypture.SelectionBrush}" />
        <Setter Property="PressedBorderBrush" Value="{DynamicResource Crypture.AccentBrush}" />
        <Setter Property="CheckedBackground" Value="{DynamicResource Crypture.SelectionBrush}" />
        <Setter Property="CheckedBorderBrush" Value="{DynamicResource Crypture.AccentBrush}" />
        <Setter Property="FocusedBackground" Value="{DynamicResource Crypture.HoverBrush}" />
        <Setter Property="FocusedBorderBrush" Value="{DynamicResource Crypture.AccentBrush}" />
        <Setter Property="WindowIconVisibility" Value="Collapsed" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ribbon:Ribbon">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ribbon:RibbonTabHeaderItemsControl x:Name="TabHeaderItemsControl"
                                Style="{StaticResource {x:Type ribbon:RibbonTabHeaderItemsControl}}"
                                HorizontalAlignment="Stretch" Margin="8,4,0,0" />
                            <Border Grid.Row="0">
                                <Popup x:Name="PART_ITEMSPRESENTERPOPUP" AllowsTransparency="True"
                                    IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                        <ContentControl x:Name="popupItemsPresenterHost" Focusable="False"
                                            KeyboardNavigation.TabNavigation="Cycle" />
                                    </Border>
                                </Popup>
                            </Border>
                            <ContentControl x:Name="mainItemsPresenterHost" Grid.Row="1" Focusable="False">
                                <Border x:Name="groupsBorder" Background="{TemplateBinding Background}" Height="100">
                                    <ItemsPresenter x:Name="ItemsPresenter" />
                                </Border>
                            </ContentControl>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMinimized" Value="True">
                            <Setter TargetName="mainItemsPresenterHost" Property="Content" Value="{x:Null}" />
                            <Setter TargetName="mainItemsPresenterHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="popupItemsPresenterHost" Property="Content"
                                Value="{Binding ElementName=groupsBorder}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ContextMenu"><Setter.Value><ContextMenu Visibility="Collapsed" /></Setter.Value></Setter>
    </Style>
    <Style TargetType="ribbon:RibbonTabHeader" BasedOn="{StaticResource Crypture.ControlStyle}">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ribbon:RibbonTabHeader">
                    <Border x:Name="PART_OuterBorder" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Crypture.HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsRibbonTabSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Crypture.SelectionBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Crypture.AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Background" Value="{DynamicResource Crypture.PanelBrush}" />
        <Setter Property="CheckedBackground" Value="{DynamicResource Crypture.SelectionBrush}" />
        <Setter Property="CheckedBorderBrush" Value="{DynamicResource Crypture.BorderBrush}" />
        <Setter Property="MouseOverBackground" Value="{DynamicResource Crypture.HoverBrush}" />
        <Setter Property="MouseOverBorderBrush" Value="{DynamicResource Crypture.BorderBrush}" />
        <Setter Property="FocusedBackground" Value="{DynamicResource Crypture.HoverBrush}" />
        <Setter Property="FocusedBorderBrush" Value="{DynamicResource Crypture.AccentBrush}" />
    </Style>
    <Style TargetType="ribbon:RibbonTab" BasedOn="{StaticResource Crypture.ControlStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ribbon:RibbonTab">
                    <ScrollViewer x:Name="ScrollViewer" HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled" Background="{TemplateBinding Background}">
                        <ItemsPresenter x:Name="ItemsPresenter" />
                    </ScrollViewer>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="False">
                            <Setter TargetName="ScrollViewer" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Background" Value="{DynamicResource Crypture.PanelBrush}" />
    </Style>
    <Style TargetType="ribbon:RibbonGroup" BasedOn="{StaticResource Crypture.ControlStyle}">
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="{DynamicResource Crypture.MutedBrush}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Background" Value="{DynamicResource Crypture.PanelBrush}" />
        <Setter Property="MouseOverBackground" Value="{DynamicResource Crypture.PanelBrush}" />
        <Setter Property="MouseOverBorderBrush" Value="{DynamicResource Crypture.BorderBrush}" />
    </Style>
    <Style TargetType="ribbon:RibbonButton" BasedOn="{StaticResource Crypture.ControlStyle}">
        <Setter Property="Background" Value="{DynamicResource Crypture.PanelBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="MouseOverBackground" Value="{DynamicResource Crypture.HoverBrush}" />
        <Setter Property="MouseOverBorderBrush" Value="{DynamicResource Crypture.BorderBrush}" />
        <Setter Property="PressedBackground" Value="{DynamicResource Crypture.SelectionBrush}" />
        <Setter Property="PressedBorderBrush" Value="{DynamicResource Crypture.AccentBrush}" />
        <Setter Property="FocusedBackground" Value="{DynamicResource Crypture.HoverBrush}" />
        <Setter Property="FocusedBorderBrush" Value="{DynamicResource Crypture.AccentBrush}" />
        <Setter Property="CanAddToQuickAccessToolBarDirectly" Value="False" />
    </Style>
    <Style TargetType="ribbon:RibbonMenuButton" BasedOn="{StaticResource Crypture.ControlStyle}">
        <Setter Property="Background" Value="{DynamicResource Crypture.PanelBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="MouseOverBackground" Value="{DynamicResource Crypture.HoverBrush}" />
        <Setter Property="MouseOverBorderBrush" Value="{DynamicResource Crypture.BorderBrush}" />
        <Setter Property="PressedBackground" Value="{DynamicResource Crypture.SelectionBrush}" />
        <Setter Property="PressedBorderBrush" Value="{DynamicResource Crypture.AccentBrush}" />
        <Setter Property="FocusedBackground" Value="{DynamicResource Crypture.HoverBrush}" />
        <Setter Property="FocusedBorderBrush" Value="{DynamicResource Crypture.AccentBrush}" />
        <Setter Property="CanAddToQuickAccessToolBarDirectly" Value="False" />
    </Style>
    <Style TargetType="ribbon:RibbonMenuItem" BasedOn="{StaticResource Crypture.ControlStyle}">
        <Setter Property="Background" Value="{DynamicResource Crypture.ControlBrush}" />
        <Setter Property="CheckedBackground" Value="{DynamicResource Crypture.SelectionBrush}" />
        <Setter Property="CheckedBorderBrush" Value="{DynamicResource Crypture.AccentBrush}" />
        <Setter Property="MouseOverBackground" Value="{DynamicResource Crypture.HoverBrush}" />
        <Setter Property="MouseOverBorderBrush" Value="{DynamicResource Crypture.BorderBrush}" />
        <Setter Property="PressedBackground" Value="{DynamicResource Crypture.SelectionBrush}" />
        <Setter Property="PressedBorderBrush" Value="{DynamicResource Crypture.AccentBrush}" />
        <Setter Property="CanAddToQuickAccessToolBarDirectly" Value="False" />
    </Style>
</ResourceDictionary>
