<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System.Configuration.ConfigurationManager">
      <section name="Crypture.Properties.Settings" type="System.Configuration.ClientSettingsSection, System.Configuration.ConfigurationManager" requirePermission="false"/>
    </sectionGroup>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System.Configuration.ConfigurationManager">
      <section name="Crypture.Properties.Settings" type="System.Configuration.ClientSettingsSection, System.Configuration.ConfigurationManager" allowExeDefinition="MachineToLocalUser" requirePermission="false"/>
    </sectionGroup>
  </configSections>
  <appSettings>
    <!-- ContentEncryptionSuite selects new saves: Aes256Gcm or Aes256CbcHmacSha256. -->
    <add key="ContentEncryptionSuite" value="Aes256Gcm"/>
    <add key="RecoveryProtectionDescriptor" value=""/>
    <add key="RecoveryCertificateBase64" value=""/>
    <!-- Password generator defaults apply when the Vault has no saved generator settings, or no Vault is open. -->
    <add key="PasswordGeneratorMinimumLength" value="20"/>
    <add key="PasswordGeneratorMaximumLength" value="24"/>
    <add key="PasswordGeneratorIncludeUppercase" value="True"/>
    <add key="PasswordGeneratorIncludeLowercase" value="True"/>
    <add key="PasswordGeneratorIncludeDigits" value="True"/>
    <add key="PasswordGeneratorIncludeSymbols" value="True"/>
    <add key="PasswordGeneratorSymbolCharacters" value="!@#$%^&amp;*()-_=+[]{}:,.?"/>
    <add key="PasswordGeneratorExcludedCharacters" value=""/>
    <add key="PasswordGeneratorExcludeSimilar" value="True"/>
    <add key="PasswordGeneratorRequireEachType" value="True"/>
    <!-- New-item defaults do not change saved items. Automatic follows enabled protection and Windows scope.
         Required certificates take precedence. Unavailable methods/scopes fall back to an available choice.
         ItemType: Text, RichText, Totp, File (File requires ShowItemFileUpload).
         ProtectionMode: Automatic, UserBased, CertificateBased. WindowsScope: Automatic, Domain, LocalUser, LocalMachine. -->
    <add key="NewItemLabel" value="My New Item"/>
    <add key="NewItemType" value="Text"/>
    <add key="NewItemProtectionMode" value="Automatic"/>
    <add key="NewItemWindowsScope" value="Automatic"/>
    <add key="NewItemRequireAllPrincipals" value="False"/>
    <add key="NewItemIncludeCurrentUser" value="True"/>
    <add key="NewItemIncludeOwnCertificates" value="True"/>
    <!-- Defaults for new authenticator setups; imported links and saved setups supply their own settings.
         Algorithm: SHA1, SHA256, SHA512. Digits: 6 or 8. PeriodSeconds: 1-3600. -->
    <add key="TotpAlgorithm" value="SHA1"/>
    <add key="TotpDigits" value="6"/>
    <add key="TotpPeriodSeconds" value="30"/>
    <add key="TotpIssuer" value=""/>
    <add key="TotpAccount" value=""/>
    <!-- Certificate wizard preferences use available providers, algorithms, and supported key lengths.
         Store: CurrentUser or LocalMachine (requires elevation; otherwise CurrentUser is selected).
         Validity starts today plus StartOffsetDays and lasts ValidityYears plus ValidityDays.
         KeyUsages: Automatic follows the key algorithm; otherwise use comma/semicolon-separated usage names.
         EnhancedKeyUsages accepts comma/semicolon-separated OIDs. Empty usage lists select no usages. -->
    <add key="CertificateGeneratorProvider" value="Microsoft Software Key Storage Provider"/>
    <add key="CertificateGeneratorKeyAlgorithm" value="RSA"/>
    <add key="CertificateGeneratorKeyLength" value="2048"/>
    <add key="CertificateGeneratorHashAlgorithm" value="SHA256"/>
    <add key="CertificateGeneratorSubject" value=""/>
    <add key="CertificateGeneratorIssuer" value=""/>
    <add key="CertificateGeneratorStartOffsetDays" value="0"/>
    <add key="CertificateGeneratorValidityYears" value="3"/>
    <add key="CertificateGeneratorValidityDays" value="0"/>
    <add key="CertificateGeneratorSelfSigned" value="True"/>
    <add key="CertificateGeneratorStore" value="CurrentUser"/>
    <add key="CertificateGeneratorShowHardwareProviders" value="True"/>
    <add key="CertificateGeneratorShowSoftwareProviders" value="True"/>
    <add key="CertificateGeneratorShowLegacyProviders" value="False"/>
    <add key="CertificateGeneratorKeyExportable" value="False"/>
    <add key="CertificateGeneratorPasswordProtectKey" value="False"/>
    <add key="CertificateGeneratorKeyUsages" value="Automatic"/>
    <add key="CertificateGeneratorEnhancedKeyUsages" value=""/>
    <!-- ClipboardTimeoutSeconds: 1-86400. Copies also clear on exit if still owned by Crypture.
         AutoConcealIdleMinutes: 0-1440; zero disables idle concealment, but session lock still conceals.
         RecentVaultLimit: 0-50; zero disables recent history. -->
    <add key="ClipboardTimeoutSeconds" value="300"/>
    <add key="AutoConcealIdleMinutes" value="10"/>
    <add key="RecentVaultLimit" value="10"/>
    <!-- SQL Server connection defaults. Authentication: Windows or SqlLogin. -->
    <add key="SqlServerDefaultServer" value=""/>
    <add key="SqlServerDefaultDatabase" value=""/>
    <add key="SqlServerAuthentication" value="Windows"/>
    <add key="SqlServerTrustServerCertificate" value="False"/>
    <add key="HideMissingCertificateKeys" value="False"/>
    <add key="RibbonMinimized" value="False"/>
    <add key="HealthCheckShowOnlyIssues" value="False"/>
  </appSettings>
  <applicationSettings>
    <Crypture.Properties.Settings>
      <setting name="ShowItemFileUpload" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="EnableDpapiNgProtection" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="EnableCertificateProtection" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="ShowCertificateTools" serializeAs="String">
        <value>True</value>
      </setting>
      <!-- Certificate selection defaults: comma/semicolon lists; exclusions take precedence.
           Key Usage accepts names such as KeyEncipherment, KeyAgreement, and DigitalSignature.
           Enhanced Key Usage accepts OIDs, e.g. 1.3.6.1.5.5.7.3.2 (Client Authentication).
           Empty include lists accept any usage; empty exclude lists exclude no usages.
           Unrestricted means no Key Usage, or no EKU / anyExtendedKeyUsage (2.5.29.37.0).
           Saved recipients and configured recovery recipients are retained regardless of these filters. -->
      <!-- Selection visibility: expiry and Windows trust anchors are independent filters.
           Enabling these settings permits selecting those certificates, including in Share With.
           Not-yet-valid, revoked, invalid, and unsupported certificates remain excluded.
           Revocation checking and certificate usage filters still apply. -->
      <setting name="ShowExpiredCertificates" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="ShowUntrustedCertificates" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="CertificateKeyUsageInclude" serializeAs="String">
        <value>KeyEncipherment;KeyAgreement</value>
      </setting>
      <setting name="CertificateKeyUsageExclude" serializeAs="String">
        <value></value>
      </setting>
      <setting name="CertificateEnhancedKeyUsageInclude" serializeAs="String">
        <value></value>
      </setting>
      <setting name="CertificateEnhancedKeyUsageExclude" serializeAs="String">
        <value></value>
      </setting>
      <setting name="AllowUnrestrictedCertificateKeyUsage" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="AllowUnrestrictedCertificateEnhancedKeyUsage" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="ItemTextExpressionFilter" serializeAs="String">
        <value />
      </setting>
      <setting name="StartupMessageText" serializeAs="String">
        <value />
      </setting>
      <setting name="AutomaticallyAddedCertificatesList" serializeAs="Xml">
        <value>
          <ArrayOfString xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" />
        </value>
      </setting>
    </Crypture.Properties.Settings>
  </applicationSettings>
  <userSettings>
    <Crypture.Properties.Settings>
      <setting name="AllowSelfSignedCertificates" serializeAs="String">
        <value>False</value>
      </setting>
      <setting name="PerformCertificateRevocationCheck" serializeAs="String">
        <value>True</value>
      </setting>
      <setting name="SecretFontFamily" serializeAs="String">
        <value>Consolas</value>
      </setting>
      <setting name="LastVault" serializeAs="String">
        <value></value>
      </setting>
      <setting name="RecentVaults" serializeAs="Xml">
        <value>
          <ArrayOfString xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" />
        </value>
      </setting>
      <setting name="ThemeMode" serializeAs="String">
        <value>System</value>
      </setting>
    </Crypture.Properties.Settings>
  </userSettings>

</configuration>
