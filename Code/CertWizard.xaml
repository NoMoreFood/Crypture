<ui:ThemedWindow xmlns:ui="clr-namespace:Crypture" x:Class="Crypture.CertWizard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Crypture" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Name="oWizardWindow" Title="Create Certificate" Width="620" Height="680" MinWidth="560" MinHeight="600" WindowStartupLocation="CenterOwner" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Loaded="oWizardWindow_Loaded" Closed="oWizardWindow_Closed" mc:Ignorable="d"
    Background="{DynamicResource Crypture.WindowBrush}" Foreground="{DynamicResource Crypture.TextBrush}"
    FocusManager.FocusedElement="{Binding ElementName=oSubjectTextBox}">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="Label" BasedOn="{StaticResource Crypture.GlyphLabel}">
            <Setter Property="Padding" Value="0,3" />
            <Setter Property="Margin" Value="0,6,0,4" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border x:Name="oWizardFooter" DockPanel.Dock="Bottom" Padding="14,10"
            BorderBrush="{DynamicResource Crypture.BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel>
                <TextBlock x:Name="oGenerationNotice" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"
                    ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                    Foreground="{DynamicResource Crypture.MutedBrush}" AutomationProperties.LiveSetting="Polite" />
                <DockPanel>
                    <Button x:Name="oCloseButton" DockPanel.Dock="Right" Content="Cl_ose" MinWidth="82"
                        Margin="8,0,0,0" Padding="12,6" IsCancel="True" Click="oCloseButton_Click" />
                    <Button x:Name="oGenerateButton" DockPanel.Dock="Right" Content="_Create" MinWidth="110"
                        Margin="12,0,0,0" Padding="12,6" IsEnabled="False" IsDefault="True"
                        Click="oGenerateButton_Click" ToolTipService.ShowOnDisabled="True"
                        Style="{StaticResource Crypture.GlyphButton}" Tag="&#xE710;" />
                    <Button x:Name="oRefreshProvidersButton" Content="_Refresh Providers"
                        HorizontalAlignment="Left" Padding="8,4" VerticalAlignment="Center"
                        IsEnabled="False" Click="oRefreshProvidersButton_Click"
                        Style="{StaticResource Crypture.GlyphButton}" Tag="&#xE72C;"
                        ToolTip="Refresh the list after connecting a smart card or other key device." />
                </DockPanel>
                <TextBlock x:Name="oProviderStatus" Text="Loading certificate providers..." Margin="0,8,0,0"
                    TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Crypture.MutedBrush}"
                    AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Border>
        <TabControl x:Name="oWizardTabs" Margin="2">
            <TabItem Header="General" Style="{StaticResource Crypture.GlyphTab}" Tag="&#xE8A5;">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14,6,14,14">
                        <Label Content="Certificate _Name:" Target="{Binding ElementName=oSubjectTextBox}"
                            Style="{StaticResource FieldLabel}" Tag="&#xE77B;" />
                        <TextBox x:Name="oSubjectTextBox" MinHeight="28" Padding="5,3"
                            TextChanged="oGenerationOptionsChanged" AutomationProperties.Name="Certificate Name" />
                        <TextBlock Margin="0,5,0,6" TextWrapping="Wrap"
                            Foreground="{DynamicResource Crypture.MutedBrush}"
                            Text="Use your name or a team name. Crypture shows this name in certificate lists." />
                        <Label Content="Create:" Style="{StaticResource FieldLabel}" Tag="&#xE710;" />
                        <WrapPanel>
                            <RadioButton x:Name="oCertificateSelfSignedRadio" Margin="0,0,16,5"
                                Content="_Self-Signed Certificate" GroupName="CertRequest" IsChecked="True"
                                Checked="oGenerationOptionsChanged" />
                            <RadioButton x:Name="oCertificateRequestRadio" Margin="0,0,0,5"
                                Content="Certificate Re_quest" GroupName="CertRequest"
                                Checked="oGenerationOptionsChanged" />
                        </WrapPanel>
                        <TextBlock x:Name="oGenerationHelp" TextWrapping="Wrap" Margin="0,0,0,6"
                            Foreground="{DynamicResource Crypture.MutedBrush}" />
                        <Label Content="_Valid From:" Target="{Binding ElementName=oValidFromDatePicker}"
                            Style="{StaticResource FieldLabel}" Tag="&#xE787;" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DatePicker x:Name="oValidFromDatePicker" MinHeight="28"
                                SelectedDateChanged="oGenerationOptionsChanged"
                                AutomationProperties.Name="Certificate Valid From" />
                            <Label Grid.Column="1" Content="to" Padding="10,3" VerticalAlignment="Center" />
                            <DatePicker x:Name="oValidUntilDatePicker" Grid.Column="2" MinHeight="28"
                                SelectedDateChanged="oGenerationOptionsChanged"
                                AutomationProperties.Name="Certificate Valid Until" />
                        </Grid>
                        <TextBlock x:Name="oValidityHelp" Margin="0,5,0,6" TextWrapping="Wrap"
                            Foreground="{DynamicResource Crypture.MutedBrush}" />
                        <Label Content="Store Private Key:" Style="{StaticResource FieldLabel}" Tag="&#xE8F1;" />
                        <WrapPanel>
                            <RadioButton x:Name="oCertificateStoreUserRadio" Content="Current _User"
                                GroupName="CertStore" IsChecked="True" Margin="0,0,16,5"
                                Checked="oGenerationOptionsChanged" />
                            <RadioButton x:Name="oCertificateStoreMachineRadio" Content="Co_mputer"
                                GroupName="CertStore" Margin="0,0,0,5" Checked="oGenerationOptionsChanged"
                                ToolTip="Run Crypture as an administrator to create a computer key."
                                ToolTipService.ShowOnDisabled="True" />
                        </WrapPanel>
                        <TextBlock Margin="0,0,0,12" TextWrapping="Wrap"
                            Foreground="{DynamicResource Crypture.MutedBrush}">
                            <Run Text="Current User keeps the key with your Windows account. " />
                            <Run Text="Computer stores it for this device and requires administrator access." />
                        </TextBlock>
                        <Border Background="{DynamicResource Crypture.PanelBrush}" Padding="12"
                            BorderBrush="{DynamicResource Crypture.BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="Key Settings" FontWeight="SemiBold" />
                                <TextBlock x:Name="oKeySummary" TextWrapping="Wrap" Margin="0,5,0,0"
                                    Foreground="{DynamicResource Crypture.MutedBrush}" />
                                <TextBlock Text="Change the provider, algorithms, or key protection on Advanced."
                                    TextWrapping="Wrap" Margin="0,5,0,0"
                                    Foreground="{DynamicResource Crypture.MutedBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Key Usages" Style="{StaticResource Crypture.GlyphTab}" Tag="&#xE8D7;">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14,6,14,14">
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,6"
                            Foreground="{DynamicResource Crypture.MutedBrush}">
                            <Run Text="Key usages describe allowed operations. Crypture encryption needs " />
                            <Run Text="Key Encipherment for RSA or Key Agreement for ECDH. " />
                            <Run Text="Extended usages are optional." />
                        </TextBlock>
                        <Label Content="_Key Usages:" Target="{Binding ElementName=oKeyUsageCombobox}"
                            Style="{StaticResource FieldLabel}" Tag="&#xE8D7;" />
                        <ListBox x:Name="oKeyUsageCombobox" Height="150"
                            ItemsSource="{Binding ElementName=oWizardWindow, Path=KeyUsages}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" Margin="4,3" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Label Content="_Extended Key Usages:" Target="{Binding ElementName=oEnhancedKeyUsageCombobox}"
                            Style="{StaticResource FieldLabel}" Tag="&#xE8FD;" />
                        <ListBox x:Name="oEnhancedKeyUsageCombobox" Height="220"
                            ItemsSource="{Binding ElementName=oWizardWindow, Path=EnhancedKeyUsages}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" Margin="4,3" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Advanced" Style="{StaticResource Crypture.GlyphTab}" Tag="&#xE713;">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14,6,14,14">
                        <Label Content="Provider Types:" Style="{StaticResource FieldLabel}" Tag="&#xE713;" />
                        <WrapPanel>
                            <CheckBox x:Name="oSoftwareCheckbox" Content="Software" IsChecked="True"
                                Margin="0,0,16,5" Checked="oProviderType_Checked" Unchecked="oProviderType_Checked"
                                ToolTip="Keys stored on this computer by a software provider." />
                            <CheckBox x:Name="oHardwareCheckbox" Content="Hardware" IsChecked="True"
                                Margin="0,0,0,5" Checked="oProviderType_Checked" Unchecked="oProviderType_Checked"
                                ToolTip="Keys held by a smart card, TPM, or other hardware provider." />
                        </WrapPanel>
                        <Label Content="_Provider:" Target="{Binding ElementName=oProviderComboBox}"
                            Style="{StaticResource FieldLabel}" Tag="&#xE8F1;" />
                        <ComboBox x:Name="oProviderComboBox" MinHeight="28" IsEditable="False"
                            ToolTip="{Binding SelectedItem, RelativeSource={RelativeSource Self}}"
                            ItemsSource="{Binding ElementName=oWizardWindow, Path=ProviderOptions.Keys}"
                            SelectedItem="{Binding ElementName=oWizardWindow, Path=SelectedProvider}"
                            SelectionChanged="oProviderComboBox_SelectionChanged" />
                        <Label Content="Key _Algorithm:" Target="{Binding ElementName=oSignatureComboBox}"
                            Style="{StaticResource FieldLabel}" Tag="&#xE8D7;" />
                        <ComboBox x:Name="oSignatureComboBox" MinHeight="28" IsEditable="False"
                            SelectedItem="{Binding ElementName=oWizardWindow, Path=SelectedSignature}"
                            SelectionChanged="oSignatureComboBox_SelectionChanged" />
                        <TextBlock x:Name="oAlgorithmHelp" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                            Foreground="{DynamicResource Crypture.MutedBrush}" />
                        <Label Content="Key _Length:" Target="{Binding ElementName=oKeyLengthTextBox}"
                            Style="{StaticResource FieldLabel}" Tag="&#xE8EF;" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="oKeyLengthTextBox" MinHeight="28" Padding="5,3" Margin="0,0,10,0"
                                TextChanged="oGenerationOptionsChanged"
                                AutomationProperties.Name="Key Length in Bits" />
                            <Label x:Name="oKeyLengthHintLabel" Grid.Column="1" Padding="0"
                                VerticalAlignment="Center" Foreground="{DynamicResource Crypture.MutedBrush}" />
                        </Grid>
                        <Label Content="_Hash Algorithm:" Target="{Binding ElementName=oHashComboBox}"
                            Style="{StaticResource FieldLabel}" Tag="&#xE8FD;" />
                        <ComboBox x:Name="oHashComboBox" MinHeight="28" IsEditable="False"
                            SelectedItem="{Binding ElementName=oWizardWindow, Path=SelectedHash}"
                            SelectionChanged="oGenerationOptionsChanged" />
                        <Label Content="_Issuer Name:" Target="{Binding ElementName=oIssuerTextBox}"
                            Style="{StaticResource FieldLabel}" Tag="&#xE716;" />
                        <TextBox x:Name="oIssuerTextBox" MinHeight="28" Padding="5,3"
                            ToolTip="Blank uses the certificate name; a CA sets the issuer for requests."
                            TextChanged="oGenerationOptionsChanged" />
                        <CheckBox x:Name="oShowLegacyCheckbox" Content="Show Legacy Providers" Margin="0,14,0,6"
                            Checked="oProviderType_Checked" Unchecked="oProviderType_Checked" />
                        <CheckBox x:Name="oKeyExportableCheckbox" Content="Allow Private Key Export" Margin="0,6,0,5"
                            ToolTip="Allows backing up or moving this private key when the provider supports export." />
                        <CheckBox x:Name="oPasswordProtectCheckbox" Content="Prompt When Using the Private Key"
                            Margin="0,6,0,5"
                            ToolTip="Requests Windows key protection. The prompt depends on the provider." />
                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                            Foreground="{DynamicResource Crypture.MutedBrush}">
                            <Run Text="ML-KEM needs an issued certificate with a CNG private key. " />
                            <Run Text="This creator cannot self-sign ML-KEM certificates." />
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</ui:ThemedWindow>
