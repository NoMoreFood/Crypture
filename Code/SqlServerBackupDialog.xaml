<ui:ThemedWindow xmlns:ui="clr-namespace:Crypture" x:Class="Crypture.SqlServerBackupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Back Up SQL Server Vault" Width="520" Height="230" MinWidth="460" MinHeight="210"
    WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
    Background="{DynamicResource Crypture.WindowBrush}"
    Foreground="{DynamicResource Crypture.TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12">
            <Run Text="SQL Server writes this backup on the server, using its service account. " />
            <Run Text="Enter a server-side path or a filename in its default backup folder." />
        </TextBlock>
        <Label Grid.Row="1" Content="_Backup path:" Target="{Binding ElementName=oBackupPath}" />
        <TextBox x:Name="oBackupPath" Grid.Row="2" MinHeight="28" Margin="0,0,0,12"
            AutomationProperties.Name="SQL Server backup path" />
        <TextBlock Grid.Row="3" Foreground="{DynamicResource Crypture.MutedBrush}" TextWrapping="Wrap"
            Text="SQL Server backup permission and write access to the destination are required." />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="100" MinHeight="30" Margin="0,0,8,0" Content="Back Up" IsDefault="True"
                Click="oBackup_Click" />
            <Button Width="100" MinHeight="30" Content="Cancel" IsCancel="True" />
        </StackPanel>
    </Grid>
</ui:ThemedWindow>
