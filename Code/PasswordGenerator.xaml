<Window x:Class="Crypture.PasswordGenerator" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Crypture"
    Title="Password Generator" Width="560" Height="700"
    MinWidth="520" MinHeight="600" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
    Icon="pack://application:,,,/Crypture;component/Safe.ico" Closed="oWindow_Closed"
    Background="{DynamicResource Crypture.WindowBrush}" Foreground="{DynamicResource Crypture.TextBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Generate a Password" FontSize="21" FontWeight="SemiBold" />
                <TextBlock x:Name="oSettingsHint" Text="Settings are remembered in this Vault when you generate."
                    Margin="0,5,0,16" Foreground="{DynamicResource Crypture.MutedBrush}" TextWrapping="Wrap" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Content="_Minimum Length:" Target="{Binding ElementName=oMinimumLength}" Padding="0,0,0,5"
                        Style="{StaticResource Crypture.GlyphLabel}" Tag="&#xE8E7;" />
                    <TextBox x:Name="oMinimumLength" Grid.Row="1" MinHeight="28" Padding="5,3" MaxLength="4"
                        TextChanged="oOptionsChanged" />
                    <Label Grid.Column="2" Content="Ma_ximum Length:" Target="{Binding ElementName=oMaximumLength}"
                        Padding="0,0,0,5"
                        Style="{StaticResource Crypture.GlyphLabel}" Tag="&#xE8E8;" />
                    <TextBox x:Name="oMaximumLength" Grid.Row="1" Grid.Column="2" MinHeight="28" Padding="5,3"
                        MaxLength="4" TextChanged="oOptionsChanged" />
                </Grid>
                <TextBlock Text="Use the same value for a fixed length (1–1024 characters)."
                    Margin="0,5,0,14" Foreground="{DynamicResource Crypture.MutedBrush}" TextWrapping="Wrap" />
                <GroupBox Header="Character Types" Padding="10,8"
                    Style="{StaticResource Crypture.GlyphGroup}" Tag="&#xE8D2;">
                    <StackPanel>
                        <WrapPanel>
                            <CheckBox x:Name="oUppercase" Content="_Uppercase (A–Z)" Margin="0,0,18,8"
                                Checked="oOptionsChanged" Unchecked="oOptionsChanged" />
                            <CheckBox x:Name="oLowercase" Content="_Lowercase (a–z)" Margin="0,0,18,8"
                                Checked="oOptionsChanged" Unchecked="oOptionsChanged" />
                            <CheckBox x:Name="oDigits" Content="_Digits (0–9)" Margin="0,0,0,8"
                                Checked="oOptionsChanged" Unchecked="oOptionsChanged" />
                        </WrapPanel>
                        <CheckBox x:Name="oSymbols" Content="_Symbols" Margin="0,0,0,5"
                            Checked="oOptionsChanged" Unchecked="oOptionsChanged" />
                        <TextBox x:Name="oSymbolCharacters" MinHeight="28" Padding="5,3" MaxLength="94"
                            Style="{StaticResource Crypture.SecretText}"
                            IsEnabled="{Binding IsChecked, ElementName=oSymbols}"
                            AutomationProperties.Name="Allowed Symbols" TextChanged="oOptionsChanged"
                            ToolTip="Customize the allowed ASCII punctuation characters." />
                    </StackPanel>
                </GroupBox>
                <CheckBox x:Name="oRequireEachType" Content="_Require at Least One of Every Selected Type"
                    Margin="0,12,0,8" Checked="oOptionsChanged" Unchecked="oOptionsChanged" />
                <CheckBox x:Name="oExcludeSimilar" Content="_Avoid Similar Characters (I l 1 O 0 o |)"
                    Margin="0,0,0,8" Checked="oOptionsChanged" Unchecked="oOptionsChanged" />
                <Label Content="_Exclude These Characters:" Target="{Binding ElementName=oExcludedCharacters}"
                    Padding="0,0,0,5"
                    Style="{StaticResource Crypture.GlyphLabel}" Tag="&#xE711;" />
                <TextBox x:Name="oExcludedCharacters" MinHeight="28" Padding="5,3" MaxLength="256"
                    Style="{StaticResource Crypture.SecretText}" TextChanged="oOptionsChanged" />
                <TextBlock x:Name="oValidationMessage" Foreground="{DynamicResource Crypture.WarningBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                    AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="oGenerateButton" Content="_Generate" HorizontalAlignment="Left" MinWidth="110"
                    Margin="0,12,0,12" Padding="12,6" IsDefault="True" Click="oGenerateButton_Click"
                    Style="{StaticResource Crypture.GlyphButton}" Tag="&#xE72C;" />
                <Border x:Name="oPasswordResult" Background="{DynamicResource Crypture.PanelBrush}"
                    BorderBrush="{DynamicResource Crypture.BorderBrush}" BorderThickness="1"
                    CornerRadius="3" Padding="10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Label Content="Secret _Font:" Target="{Binding ElementName=oSecretFontSelector}"
                                Style="{StaticResource Crypture.GlyphLabel}" Tag="&#xE185;" />
                            <local:SecretFontSelector x:Name="oSecretFontSelector" Width="210" />
                        </StackPanel>
                        <Label Content="_Password:" Target="{Binding ElementName=oGeneratedPassword}" Padding="0,0,0,5"
                            Style="{StaticResource Crypture.GlyphLabel}" Tag="&#xE8D7;" />
                        <DockPanel>
                            <Button x:Name="oCopyButton" DockPanel.Dock="Right" Margin="6,0,0,0"
                                VerticalAlignment="Top" IsEnabled="False" Click="oCopyButton_Click"
                                Style="{StaticResource Crypture.CopyButton}" AutomationProperties.Name="Copy Password"
                                ToolTip="Copy the entire password. Clears after 5 minutes or when Crypture closes." />
                            <TextBox x:Name="oGeneratedPassword" IsReadOnly="True" IsUndoEnabled="False" MinHeight="56"
                                MaxHeight="100" Padding="6" FontSize="18" TextWrapping="Wrap"
                                Style="{StaticResource Crypture.SecretText}"
                                VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Generated Password"
                                ToolTip="Copied passwords clear after 5 minutes or when Crypture closes." />
                        </DockPanel>
                        <TextBlock x:Name="oPasswordStatus" Text="Uses Windows cryptographic randomness."
                            Foreground="{DynamicResource Crypture.MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="oInsertButton" Content="_Insert Password" MinWidth="110" Margin="8,0,0,0" Padding="10,6"
                IsEnabled="False" Click="oInsertButton_Click" ToolTip="Replace the selected text or insert at the cursor."
                Style="{StaticResource Crypture.GlyphButton}" Tag="&#xE77F;" />
            <Button Content="Cl_ose" MinWidth="82" Margin="8,0,0,0" Padding="10,6" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
