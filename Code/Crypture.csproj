<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>Crypture.PortableStartup</StartupObject>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>14.0</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>Crypture</RootNamespace>
    <AssemblyName>Crypture</AssemblyName>
    <Version>2.1.0</Version>
    <ApplicationIcon>Safe.ico</ApplicationIcon>
    <ApplicationManifest>Properties\app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DefaultItemExcludes>$(DefaultItemExcludes);packages/**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.7" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Safe.ico;Images\*.png" />
    <EmbeddedResource Include="Data\SQLite.sql" LogicalName="Crypture.SqliteSchema" />
    <EmbeddedResource Include="Data\SqlServer.sql" LogicalName="Crypture.SqlServerSchema" />
    <EmbeddedResource Include="Data\SqlServerSecurity.sql" LogicalName="Crypture.SqlServerSecurity" />
    <EmbeddedResource Include="Data\SqlServerEnrollment.sql" LogicalName="Crypture.SqlServerEnrollment" />
    <EmbeddedResource Include="Data\SqlServerEscrow.sql" LogicalName="Crypture.SqlServerEscrow" />
    <EmbeddedResource Include="Data\License - DotNet Libraries.txt" LogicalName="Crypture.RuntimeNotices" />
    <EmbeddedResource Include="$(RuntimeNoticesFile)" LogicalName="Crypture.RuntimeThirdPartyNotices"
        Condition="'$(RuntimeNoticesFile)' != ''" />
  </ItemGroup>
  <Target Name="FilterPortablePayload" BeforeTargets="_ComputeFilesToBundle"
      Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.Extension)' == '.config' Or
              '%(ResolvedFileToPublish.Extension)' == '.pdb' Or '%(ResolvedFileToPublish.Extension)' == '.xml' Or
              '%(ResolvedFileToPublish.Filename)' == 'System.Design' Or
              '%(ResolvedFileToPublish.Filename)' == 'System.Drawing.Design'" />
    </ItemGroup>
  </Target>
</Project>
