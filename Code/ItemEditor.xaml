<Window x:Class="Crypture.ItemEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ribbon="clr-namespace:System.Windows.Controls.Ribbon;assembly=System.Windows.Controls.Ribbon" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Crypture" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Name="oRootWindow" Title="Item Viewer &amp; Editor" Width="1080" Height="720" MinWidth="920" MinHeight="600" WindowStartupLocation="CenterOwner" PreviewKeyDown="oRootWindow_PreviewKeyDown" Closing="oRootWindow_Closing" Icon="pack://application:,,,/Crypture;component/Safe.ico" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" mc:Ignorable="d"
    Background="{DynamicResource Crypture.WindowBrush}" Foreground="{DynamicResource Crypture.TextBrush}">
    <Window.Resources>
        <local:CheckIfItemIsSelectedConverter x:Key="CheckIfItemIsSelectedConverter" />
        <local:CheckIfDateIsNotSetConverter x:Key="CheckIfDateIsNotSetConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ribbon:Ribbon x:Name="ribbon" IsMinimized="False">
            <!--  Tabs  -->
            <ribbon:RibbonTab Header="Home">
                <ribbon:RibbonGroup Header="Item Actions">
                    <ribbon:RibbonButton x:Name="oLoadItemButton" Height="Auto" Margin="6,6,6,0" Click="oLoadItemButton_Click" Label="Decrypt &amp; Load" LargeImageSource="pack://application:,,,/Crypture;component/Images/Load.png" ControlSizeDefinition="{StaticResource Crypture.LargeRibbonControl}" />
                    <ribbon:RibbonButton x:Name="oSaveItemButton" Height="Auto" Margin="6,6,6,0" Click="oSaveItemButton_Click" Label="Encrypt &amp; Save" LargeImageSource="pack://application:,,,/Crypture;component/Images/Save.png" ControlSizeDefinition="{StaticResource Crypture.LargeRibbonControl}" />
                    <ribbon:RibbonButton x:Name="oRemoveItemButton" Height="Auto" Margin="6,6,6,0" Click="oRemoveItemButton_Click" Label="Remove Item" SmallImageSource="pack://application:,,,/Crypture;component/Images/Remove.png" ControlSizeDefinition="{StaticResource Crypture.SmallRibbonControl}" />
                    <ribbon:RibbonButton x:Name="oGeneratePasswordButton" Label="Generate Password..." ControlSizeDefinition="{StaticResource Crypture.SmallRibbonControl}"
                        Margin="6,6,6,0" Click="oGeneratePasswordButton_Click"
                        SmallImageSource="pack://application:,,,/Crypture;component/Images/Refresh.png"
                        ToolTip="Generate a password and insert it at the cursor in an unlocked text item." />
                    <ribbon:RibbonButton x:Name="oUploadAFile" Height="Auto" Margin="6,6,6,0" Click="oUploadAFile_Click" Label="Upload File..." SmallImageSource="pack://application:,,,/Crypture;component/Images/Upload.png" ControlSizeDefinition="{StaticResource Crypture.SmallRibbonControl}" />
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup Header="Privacy">
                    <ribbon:RibbonButton x:Name="oLockItemButton" Margin="6,6,6,0" Label="Lock Item"
                        Click="oLockItemButton_Click" ControlSizeDefinition="{StaticResource Crypture.LargeRibbonControl}" ToolTip="Clear decrypted content (Ctrl+L)"
                        LargeImageSource="pack://application:,,,/Crypture;component/Images/Save.png" />
                </ribbon:RibbonGroup>
                <ribbon:RibbonGroup x:Name="oCertificateSharingGroup" Header="Certificate Sharing">
                    <ribbon:RibbonMenuButton x:Name="oAddCertDropDown" Margin="6,6,6,0" DisplayMemberPath="Name" Label="Share With..." LargeImageSource="pack://application:,,,/Crypture;component/Images/Share.png" ControlSizeDefinition="{StaticResource Crypture.LargeRibbonControl}">
                        <ribbon:RibbonMenuButton.ItemContainerStyle>
                            <Style BasedOn="{StaticResource {x:Type ribbon:RibbonMenuItem}}" TargetType="ribbon:RibbonMenuItem">
                                <EventSetter Event="Click" Handler="MenuItemWithRadioButtons_Click" />
                                <Setter Property="IsCheckable" Value="True" />
                                <Setter Property="StaysOpenOnClick" Value="True" />
                                <Setter Property="IsChecked">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource CheckIfItemIsSelectedConverter}" Mode="OneWay">
                                            <Binding ElementName="oRootWindow" Path="UserListSelected" />
                                            <Binding Path="." />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ribbon:RibbonMenuButton.ItemContainerStyle>
                    </ribbon:RibbonMenuButton>
                </ribbon:RibbonGroup>
            </ribbon:RibbonTab>
        </ribbon:Ribbon>
        <DockPanel x:Name="oEditorPanels" Grid.Row="1">
            <ScrollViewer Width="380" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                DockPanel.Dock="Left">
                <StackPanel Margin="14,8,14,12">
                    <Label Content="Item _Label:" Target="{Binding ElementName=oItemLabel}" Padding="0,3"
                        Style="{StaticResource Crypture.GlyphLabel}" Tag="&#xE8EC;" />
                    <TextBox x:Name="oItemLabel" MinHeight="28" Padding="5,3"
                        Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" TextChanged="oItemChanged"
                        ToolTip="Labels are visible in the Vault and are not encrypted." />
                    <Label Content="Item _Type:" Target="{Binding ElementName=oItemTypeSelector}"
                        Style="{StaticResource Crypture.GlyphLabel}" Tag="&#xE8A5;" Margin="0,6,0,0" />
                    <ComboBox x:Name="oItemTypeSelector" MinHeight="28"
                        SelectionChanged="oItemTypeChanged" AutomationProperties.Name="Item Type">
                        <ComboBoxItem Content="Text Secret" />
                        <ComboBoxItem Content="TOTP Authenticator" />
                        <ComboBoxItem Content="File Attachment" />
                    </ComboBox>
                    <Grid Margin="0,8,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label Content="Created:" Margin="0,2" Padding="0"
                            Style="{StaticResource Crypture.GlyphLabel}" Tag="&#xE787;" />
                        <TextBlock x:Name="oItemCreatedDate" Grid.Column="1" Margin="0,2"
                            Text="{Binding CreatedDate, Converter={StaticResource CheckIfDateIsNotSetConverter}, StringFormat='yyyy-MM-dd HH:mm:ss'}" />
                        <Label Grid.Row="1" Content="Modified:" Margin="0,2" Padding="0"
                            Style="{StaticResource Crypture.GlyphLabel}" Tag="&#xE823;" />
                        <TextBlock x:Name="oItemModifiedDate" Grid.Row="1" Grid.Column="1" Margin="0,2"
                            Text="{Binding ModifiedDate, Converter={StaticResource CheckIfDateIsNotSetConverter}, StringFormat='yyyy-MM-dd HH:mm:ss'}" />
                        <Label Grid.Row="2" Content="Modified By:" Margin="0,2" Padding="0"
                            Style="{StaticResource Crypture.GlyphLabel}" Tag="&#xE77B;" />
                        <TextBlock x:Name="oItemModifiedBy" Grid.Row="2" Grid.Column="1" Margin="0,2"
                            Text="{Binding ModifiedByDisplay}" TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding ModifiedByDisplay}" />
                    </Grid>
                    <Border Padding="12" BorderBrush="{DynamicResource Crypture.BorderBrush}" BorderThickness="1" CornerRadius="3" Background="{DynamicResource Crypture.PanelBrush}">
                        <StackPanel>
                            <Label Content="_Encryption:" Target="{Binding ElementName=oProtectionMode}" Padding="0,0,0,5"
                                Style="{StaticResource Crypture.GlyphLabel}" Tag="&#xE72E;" />
                            <ComboBox x:Name="oProtectionMode" MinHeight="28" SelectedIndex="0"
                                SelectionChanged="oProtectionChanged" AutomationProperties.Name="Encryption Method">
                                <ComboBoxItem x:Name="oDpapiNgProtection" Content="User Based" />
                                <ComboBoxItem x:Name="oCertificateProtection" Content="Certificate Based" />
                            </ComboBox>
                            <TextBlock x:Name="oProtectionDisabledNotice" Visibility="Collapsed" Margin="0,8,0,0"
                                TextWrapping="Wrap" Foreground="{DynamicResource Crypture.WarningBrush}"
                                AutomationProperties.Name="Disabled Encryption" />
                            <TextBlock x:Name="oRequiredCertificateNotice" Visibility="Collapsed" Margin="0,8,0,0"
                                TextWrapping="Wrap" Foreground="{DynamicResource Crypture.WarningBrush}"
                                Text="Required recipient certificates are configured. Saving requires Certificate Based encryption." />
                            <TextBlock x:Name="oRecoveryNotice" Visibility="Collapsed" Margin="0,8,0,0"
                                TextWrapping="Wrap" Foreground="{DynamicResource Crypture.WarningBrush}"
                                AutomationProperties.Name="Emergency Recovery" />
                            <StackPanel x:Name="oPrincipalPanel" Margin="0,8,0,0">
                                <Label Content="_Scope:" Target="{Binding ElementName=oPrincipalScope}" Padding="0,0,0,4"
                                    Style="{StaticResource Crypture.GlyphLabel}" Tag="&#xE774;" />
                                <ComboBox x:Name="oPrincipalScope" MinHeight="28" SelectedIndex="0"
                                    SelectionChanged="oProtectionChanged" AutomationProperties.Name="User Based Encryption Scope">
                                    <ComboBoxItem x:Name="oDomainScope" Content="Domain Users and Groups"
                                        ToolTip="Requires Active Directory domain credentials and key distribution."
                                        ToolTipService.ShowOnDisabled="True" />
                                    <ComboBoxItem Content="Saving Account's Local Windows Profile" />
                                    <ComboBoxItem Content="All Users on This Computer" />
                                </ComboBox>
                                <TextBlock x:Name="oDomainNotice" TextWrapping="Wrap" Margin="0,8,0,4"
                                    Foreground="{DynamicResource Crypture.MutedBrush}" Visibility="Collapsed"
                                    Text="Domain scope needs Active Directory. Choose a local scope or Certificate Based encryption." />
                                <TextBlock x:Name="oPrincipalHint" TextWrapping="Wrap" Margin="0,8,0,4" Foreground="{DynamicResource Crypture.MutedBrush}" />
                                <StackPanel x:Name="oPrincipalTargets">
                                    <StackPanel x:Name="oPrincipalControls">
                                        <Label Content="_Account or SID:" Target="{Binding ElementName=oPrincipalName}" Padding="0,4"
                                            Style="{StaticResource Crypture.GlyphLabel}" Tag="&#xE716;" />
                                        <DockPanel>
                                            <Button Content="A_dd" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,3"
                                                IsDefault="{Binding IsKeyboardFocusWithin, ElementName=oPrincipalName}"
                                                Click="oAddPrincipal_Click"
                                                Style="{StaticResource Crypture.GlyphButton}" Tag="&#xE710;" />
                                            <TextBox x:Name="oPrincipalName" MinHeight="28" Padding="5,3"
                                                ToolTip="Enter DOMAIN\account, user@domain, or a domain SID." />
                                        </DockPanel>
                                        <WrapPanel Margin="0,6,0,6">
                                            <Button Content="_Browse..." Padding="8,3" Click="oBrowsePrincipals_Click"
                                                Style="{StaticResource Crypture.GlyphButton}" Tag="&#xE721;" />
                                            <Button Content="Add _Me" Margin="6,0,0,0" Padding="8,3" Click="oAddCurrentPrincipal_Click"
                                                Style="{StaticResource Crypture.GlyphButton}" Tag="&#xE77B;" />
                                            <Button Content="_Remove" Margin="6,0,0,0" Padding="8,3" Click="oRemovePrincipal_Click"
                                                Style="{StaticResource Crypture.GlyphButton}" Tag="&#xE738;" />
                                        </WrapPanel>
                                    </StackPanel>
                                    <ListBox x:Name="oPrincipalList" Height="96" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        HorizontalContentAlignment="Stretch"
                                        AutomationProperties.Name="Selected Users and Groups">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="3,3">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Sid}" FontSize="11"
                                                        Foreground="{DynamicResource Crypture.MutedBrush}"
                                                        TextTrimming="CharacterEllipsis" ToolTip="{Binding Sid}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <ComboBox x:Name="oPrincipalMatch" MinHeight="28" Margin="0,8,0,0" SelectedIndex="0"
                                        SelectionChanged="oProtectionChanged" AutomationProperties.Name="User and Group Matching Rule">
                                        <ComboBoxItem Content="Allow Any Listed User or Group" />
                                        <ComboBoxItem Content="Require All Listed Users and Groups" />
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="oCertificatePanel" Visibility="Collapsed" Margin="0,10,0,0">
                                <TextBlock Text="Select recipient certificates using Share With in the ribbon."
                                    TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource Crypture.MutedBrush}" />
                                <TextBlock Text="{x:Static local:CertificateKeyProtection.AvailabilityDescription}"
                                    TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource Crypture.MutedBrush}" />
                                <TextBlock x:Name="oCertificateUsageNotice" Visibility="Collapsed" TextWrapping="Wrap"
                                    Margin="0,0,0,8" Foreground="{DynamicResource Crypture.WarningBrush}"
                                    AutomationProperties.Name="Certificate Usage Filters" />
                                <ListView x:Name="oItemSharedWith" MinHeight="80" MaxHeight="180"
                                    IsHitTestVisible="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding AlgorithmDisplay}" FontSize="11"
                                                    Foreground="{DynamicResource Crypture.MutedBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                    Foreground="{DynamicResource Crypture.MutedBrush}"
                                    Text="For post-quantum protection, every recipient, including emergency recovery, must use a post-quantum algorithm. Each recipient can decrypt independently." />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Width="1" Background="{DynamicResource Crypture.BorderBrush}" DockPanel.Dock="Left" />
            <DockPanel DockPanel.Dock="Right">
                <StackPanel DockPanel.Dock="Top" Margin="10,5,10,0">
                    <DockPanel>
                        <Button x:Name="oCopyContentButton" DockPanel.Dock="Right"
                            Style="{StaticResource Crypture.CopyButton}" AutomationProperties.Name="Copy Item Content"
                            Command="ApplicationCommands.Copy" CommandParameter="All"
                            CommandTarget="{Binding ElementName=oItemData}"
                            ToolTip="Copy all unlocked text. Clears automatically or when Crypture closes." />
                        <Label x:Name="oContentTitle" HorizontalAlignment="Center" Content="Protected Item Content"
                            Style="{StaticResource Crypture.GlyphLabel}" Tag="&#xE8A5;" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="Secret _Font:" Target="{Binding ElementName=oSecretFontSelector}"
                            Style="{StaticResource Crypture.GlyphLabel}" Tag="&#xE185;" />
                        <local:SecretFontSelector x:Name="oSecretFontSelector" Width="210" />
                    </StackPanel>
                </StackPanel>
                <Grid Margin="10,5,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="oTextLockImage" MaxWidth="160" MaxHeight="180" Grid.Row="0" Grid.Column="0" Margin="10,10" HorizontalAlignment="Center" IsEnabled="False" Opacity="0.4" Source="pack://application:,,,/Crypture;component/Images/Save.png" Visibility="Collapsed" />
                    <TextBox x:Name="oItemData" Grid.Row="0" Grid.Column="0" AcceptsReturn="True"
                        AcceptsTab="True" Padding="8" IsUndoEnabled="False"
                        Style="{StaticResource Crypture.SecretText}"
                        ToolTip="Copied or cut text clears from the clipboard automatically or when Crypture closes."
                        TextChanged="oItemChanged" AutomationProperties.Name="Protected Item Content" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Visibility="Collapsed" />
                    <local:TotpPanel x:Name="oTotpPanel" Visibility="Collapsed" />
                    <Button x:Name="oDownloadPanel" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                        Click="oDownloadPanel_Click" Visibility="Collapsed" Padding="12" AutomationProperties.Name="Save Decrypted File">
                        <StackPanel>
                        <Image Width="100" Margin="10,10" HorizontalAlignment="Center" IsEnabled="False" Source="pack://application:,,,/Crypture;component/Images/Download.png" Stretch="Uniform" />
                        <Label x:Name="oDownloadTextBox" HorizontalAlignment="Center" Content="Save Decrypted File..." />
                    </StackPanel>
                    </Button>
                </Grid>
            </DockPanel>
        </DockPanel>
        <StatusBar Grid.Row="2">
            <TextBlock x:Name="oItemStatus" Margin="8,2" />
        </StatusBar>
        <Border x:Name="oPrivacyShield" Grid.RowSpan="3" Panel.ZIndex="100" Visibility="Collapsed"
            Background="{DynamicResource Crypture.WindowBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" MaxWidth="460">
                <TextBlock Text="Content concealed" FontSize="22" FontWeight="SemiBold"
                    HorizontalAlignment="Center" />
                <TextBlock x:Name="oPrivacyMessage" Margin="0,12,0,18" TextAlignment="Center"
                    TextWrapping="Wrap" Foreground="{DynamicResource Crypture.MutedBrush}"
                    AutomationProperties.LiveSetting="Polite" />
                <Button x:Name="oRevealButton" Content="_Reveal" MinWidth="110" Padding="12,6"
                    HorizontalAlignment="Center" Click="oRevealButton_Click"
                    Style="{StaticResource Crypture.GlyphButton}" Tag="&#xE890;" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
